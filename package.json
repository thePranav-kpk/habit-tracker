{
  "name": "atomic-habits-tracker-mern",
  "version": "1.0.0",
  "description": "Full-stack MERN Habit Tracker web application with GitHub-style contribution heatmaps, streaks, and dark mode",
  "scripts": {
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm start"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongoose": "^8.8.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "qrcode": "^1.5.4",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
